# ============================================================
# SmartShop AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ─────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api

# ─────────────────────────────────────────
# DATABASE — PostgreSQL
# ─────────────────────────────────────────
DATABASE_URL="postgresql://smartshop:smartshop_password@localhost:5432/smartshop_db?schema=public"

# ─────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────────────────────────────────
# JWT AUTHENTICATION
# ─────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_min_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────
# AI PROVIDERS
# ─────────────────────────────────────────
# Primary provider: gemini | groq
AI_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Groq (future provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# ─────────────────────────────────────────
# STORAGE (Cloudinary or S3-compatible)
# ─────────────────────────────────────────
STORAGE_PROVIDER=cloudinary

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# S3-compatible (MinIO / AWS S3)
S3_ENDPOINT=
S3_BUCKET=smartshop-assets
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_TTL=60
AI_RATE_LIMIT_MAX=20

# ─────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────
LOG_LEVEL=debug

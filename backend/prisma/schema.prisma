// ============================================================
// SmartShop AI — Prisma Schema
// PostgreSQL + pgvector
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), pg_trgm, unaccent]
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum AnalyticsEventType {
  PRODUCT_VIEW
  PRODUCT_SEARCH
  PRODUCT_COMPARE
  RECOMMENDATION_CLICK
  WISHLIST_ADD
  WISHLIST_REMOVE
  CHAT_MESSAGE
}

// ─────────────────────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  avatarUrl String?
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  preferences     UserPreferences?
  wishlistItems   WishlistItem[]
  reviews         Review[]
  conversations   Conversation[]
  recommendations Recommendation[]
  analyticsEvents AnalyticsEvent[]

  @@index([email])
  @@map("users")
}

model UserPreferences {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  preferredBrands      String[]
  preferredCategories  String[]
  budgetMin            Float?
  budgetMax            Float?
  useCases             String[]

  // Preference ratings 1–5
  performancePreference Int?
  batteryPreference     Int?
  cameraPreference      Int?
  designPreference      Int?

  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

// ─────────────────────────────────────────────────────────────
// PRODUCT CATALOG
// ─────────────────────────────────────────────────────────────

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  imageUrl    String?
  parentId    String?
  isActive    Boolean @default(true)

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@map("categories")
}

model Brand {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  logoUrl  String?
  website  String?
  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@map("brands")
}

model Product {
  id            String  @id @default(uuid())
  name          String
  slug          String  @unique
  description   String
  price         Float
  originalPrice Float?
  imageUrl      String?
  images        String[]
  isActive      Boolean @default(true)
  isFeatured    Boolean @default(false)

  // Ratings & popularity
  rating      Float @default(0)
  reviewCount Int   @default(0)
  viewCount   Int   @default(0)

  // JSONB — flexible specs for any product category
  // (laptops, phones, TVs, headphones, cameras, tablets, monitors, etc.)
  specifications Json @default("{}")

  // Vector embedding for semantic/similarity search (pgvector)
  // Stored as Float[] in DB via the vector extension; dimension 768 (Gemini text-embedding-004)
  embedding Unsupported("vector(768)")?

  // Full-text search tsvector (auto-generated by Postgres trigger in migration)
  searchVector Unsupported("tsvector")?

  categoryId String
  brandId    String
  category   Category @relation(fields: [categoryId], references: [id])
  brand      Brand    @relation(fields: [brandId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  reviews         Review[]
  wishlistItems   WishlistItem[]
  recommendations Recommendation[]
  analyticsEvents AnalyticsEvent[]

  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([price])
  @@index([rating])
  @@index([isActive])
  @@map("products")
}

// ─────────────────────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────────────────────

model Review {
  id        String @id @default(uuid())
  rating    Int // 1–5
  comment   String

  // AI-generated sentiment analysis (populated in Phase 11)
  sentiment        Float? // 0–1
  sentimentDetails Json?  @default("{}")

  userId    String
  productId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────
// WISHLIST
// ─────────────────────────────────────────────────────────────

model WishlistItem {
  id        String @id @default(uuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// ─────────────────────────────────────────────────────────────
// CONVERSATIONS & MULTI-TURN MEMORY
// ─────────────────────────────────────────────────────────────

model Conversation {
  id     String @id @default(uuid())
  userId String
  title  String

  // Full message history stored as JSONB array:
  // [{ role: "user"|"assistant", content: string, timestamp: string }]
  messages Json @default("[]")

  // Structured conversation state — tracks extracted requirements across turns:
  // { category, budgetMax, ramMin, brandFilter, ... }
  structuredState Json @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recommendations Recommendation[]

  @@index([userId])
  @@map("conversations")
}

// ─────────────────────────────────────────────────────────────
// RECOMMENDATIONS
// ─────────────────────────────────────────────────────────────

model Recommendation {
  id     String @id @default(uuid())
  userId String
  productId      String
  conversationId String?

  score               Float    // 0–100 from RankingEngineService
  reason              String
  matchedRequirements String[]

  // Snapshot of the ranking breakdown at time of recommendation
  rankingBreakdown Json @default("{}")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([score])
  @@map("recommendations")
}

// ─────────────────────────────────────────────────────────────
// ANALYTICS
// ─────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id        String             @id @default(uuid())
  event     AnalyticsEventType
  userId    String?
  productId String?
  metadata  Json               @default("{}")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([event])
  @@index([userId])
  @@index([productId])
  @@index([createdAt])
  @@map("analytics_events")
}
